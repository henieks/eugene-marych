<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <link rel="stylesheet" href="../../../scss/style.scss">
  <link rel="stylesheet" href="../../../scss/homepage.scss">

  <title>{{ title }}</title>
  <style>
    body { max-width: 72ch; margin: 3rem auto; padding: 0 1rem; line-height: 1.6; }
    img { max-width: 100%; height: auto; }
    .meta { color:#666; font-size:.9rem; margin:.5rem 0 1rem; }
    a { text-decoration: none; }
  </style>
</head>
<body>
  <nav><a href="/blog/">← Все посты</a> · <a href="/">Главная</a></nav>
  <article>
    <h2>{{ title }}</h2>
    {% if date %}<div class="meta">{{ date | ruDate }}</div>{% endif %} 
    {{ content | safe }}
  </article>
</body>
</html>